diff --git a/picoloop/InputManager.cpp b/picoloop/InputManager.cpp
index 71590bc..e1bb090 100644
--- a/picoloop/InputManager.cpp
+++ b/picoloop/InputManager.cpp
@@ -384,7 +384,8 @@ int InputManager::handleKey()
 	  this->updateState(event.jbutton.button,1);
 	  break;
 
-#ifdef RG35XXSP
+#if defined(RG35XXSP) || defined(MIYOO_FLIP)
+	// RG35XX SP e Miyoo Flip: la croce arriva come hat 0 del joystick.
 	case SDL_JOYHATMOTION:
 	  keypressrelease=1;
 	  joy=1;
@@ -406,6 +407,36 @@ int InputManager::handleKey()
 	  break;
 #endif
 
+#ifdef MIYOO_FLIP
+	// Miyoo Flip: lo stick sinistro (assi 0/1) fa da croce, con rilascio quando
+	// torna al centro (il codice generico qui sotto non rilascia mai e lascerebbe
+	// la direzione «premuta»). Gli altri assi (L2/R2 = 2/5, stick destro = 3/4)
+	// vengono ignorati: i grilletti a riposo valgono -32768 e sarebbero letti
+	// come pressioni continue.
+	case SDL_JOYAXISMOTION:
+	  if (event.jaxis.axis == 0 || event.jaxis.axis == 1)
+	    {
+	      const int neg    = (event.jaxis.axis == 0) ? BUTTON_LEFT  : BUTTON_UP;
+	      const int pos    = (event.jaxis.axis == 0) ? BUTTON_RIGHT : BUTTON_DOWN;
+	      const int newneg = (event.jaxis.value < -16000) ? 1 : 0;
+	      const int newpos = (event.jaxis.value >  16000) ? 1 : 0;
+	      if (m_key_state[neg] != newneg)
+		{
+		  this->updateState(neg, newneg);
+		  last_key   = neg;
+		  last_event = newneg ? KEYPRESSED : KEYRELEASED;
+		  keypressrelease=1;
+		}
+	      if (m_key_state[pos] != newpos)
+		{
+		  this->updateState(pos, newpos);
+		  last_key   = pos;
+		  last_event = newpos ? KEYPRESSED : KEYRELEASED;
+		  keypressrelease=1;
+		}
+	    }
+	  break;
+#else
 	case SDL_JOYAXISMOTION:  /* Handle Joystick Motion */
 	  if ( ( event.jaxis.value < -3200 ) || (event.jaxis.value > 3200 ) ) 
 	    {
@@ -424,6 +455,7 @@ int InputManager::handleKey()
 		  keypressrelease=1;
                 }
 	    }
+#endif // MIYOO_FLIP
 	}
       
       if (key)
diff --git a/picoloop/Machine/Open303/GlobalFunctions.h b/picoloop/Machine/Open303/GlobalFunctions.h
index 5a0e8b5..fc61279 100755
--- a/picoloop/Machine/Open303/GlobalFunctions.h
+++ b/picoloop/Machine/Open303/GlobalFunctions.h
@@ -42,7 +42,14 @@ INLINE double degreeToRadiant(double degrees);
 INLINE double euclideanDistance(double x1, double y1, double x2, double y2);
 
 /** Calculates the exponential function with base 10. */
-INLINE double exp10(double x);
+// glibc dichiara exp10() con throw(): clang pretende la stessa specifica anche
+// qui (g++ la tollera), altrimenti "missing exception specification".
+#if defined(__GLIBC__)
+#define ROSIC_EXP10_THROW throw()
+#else
+#define ROSIC_EXP10_THROW
+#endif
+INLINE double exp10(double x) ROSIC_EXP10_THROW;
 
 /** Calculates the exponential function with base 2. */
 INLINE double exp2(double x);
@@ -228,7 +235,7 @@ INLINE double euclideanDistance(double x1, double y1, double x2, double y2)
   return sqrt( (x2-x1)*(x2-x1) + (y2-y1)*(y2-y1) );
 }
 
-INLINE double exp10(double x)
+INLINE double exp10(double x) ROSIC_EXP10_THROW
 {
   return exp(LN10*x);
 }
diff --git a/picoloop/Master.h b/picoloop/Master.h
index 76db590..99727c3 100644
--- a/picoloop/Master.h
+++ b/picoloop/Master.h
@@ -297,7 +297,11 @@ void loadPicoloopIni(const char *path);
 #ifdef PC_DESKTOP
 #define MAX_PATTERN_BY_PROJECT 128
 
+// Miyoo Flip: build senza RtMidi (niente MIDI in/out, meno dipendenze),
+// quindi __RTMIDI__ non va forzato qui.
+#ifndef MIYOO_FLIP
 #define __RTMIDI__      1
+#endif
 #define SCREEN_WIDTH	320
 #define SCREEN_HEIGHT	240
 #define SCREEN_DEPTH	16
@@ -432,6 +436,55 @@ void loadPicoloopIni(const char *path);
 #define BUTTON_VOLDOWN      SDLK_VOLUMEDOWN
 #endif
 
+#ifdef MIYOO_FLIP
+// Miyoo Flip (spruceOS/Cirmolo, SDL 2.32 con backend KMSDRM + ALSA).
+// I tasti arrivano come eventi joystick SDL del pad «MIYOO Player1»
+// (indici verificati sulla console):
+//   B=0  A=1  Y=2  X=3  L1=4  R1=5  SELECT=6  START=7
+//   croce = SDL_JOYHATMOTION hat 0 (SDL_HAT_UP 1, RIGHT 2, DOWN 4, LEFT 8),
+//   tradotta in InputManager.cpp nei codici 200+valore come nel port RG35XX SP;
+//   stick sinistro = assi 0/1 (usato come croce), L2/R2 = assi 2/5 (ignorati).
+// Stessi ruoli del port RG35XX SP: A conferma, B indietro, L1/R1 cambiano
+// pagina, SELECT+START esce. Questo blocco sovrascrive le define PC_DESKTOP.
+#undef  DEFAULTSAMPLES
+#undef  BUTTON_B
+#undef  BUTTON_A
+#undef  BUTTON_X
+#undef  BUTTON_Y
+#undef  BUTTON_UP
+#undef  BUTTON_DOWN
+#undef  BUTTON_LEFT
+#undef  BUTTON_RIGHT
+#undef  BUTTON_SELECT
+#undef  BUTTON_START
+#undef  BUTTON_L
+#undef  BUTTON_R
+#undef  KEYPRESSED
+#undef  KEYRELEASED
+
+#define DEFAULTSAMPLES   1024
+
+#define BUTTON_B            0
+#define BUTTON_A            1
+#define BUTTON_Y            2
+#define BUTTON_X            3
+#define BUTTON_L            4
+#define BUTTON_R            5
+#define BUTTON_SELECT       6
+#define BUTTON_START        7
+
+#define BUTTON_UP           201
+#define BUTTON_RIGHT        202
+#define BUTTON_DOWN         204
+#define BUTTON_LEFT         208
+
+#define BUTTON_POWER        SDLK_POWER
+#define BUTTON_PAUSE        SDLK_PAUSE
+
+#define KEYPRESSED          SDL_JOYBUTTONDOWN
+#define KEYRELEASED         SDL_JOYBUTTONUP
+#endif
+
 #ifdef  RASPI3_ILI9486
 #define MAX_PATTERN_BY_PROJECT 128
 //#define SCREEN_WIDTH	480
